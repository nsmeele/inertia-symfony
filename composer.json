{
    "name": "nsmeele/inertia-symfony",
    "description": "Inertia.js server-side adapter for Symfony 8.1+",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "inertia",
        "inertiajs",
        "bundle"
    ],
    "require": {
        "php": ">=8.4",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "symfony/validator": "Needed to turn #[MapRequestPayload], #[MapQueryString] and #[MapUploadedFile] validation failures into Inertia errors.",
        "symfony/serializer": "Needed for #[MapRequestPayload] and #[MapQueryString].",
        "symfony/translation": "Needed to translate validation messages into locales other than English.",
        "symfony/form": "Needed to flash Symfony form errors with ValidationErrors::fromForm()."
    },
    "autoload": {
        "psr-4": {
            "Nsmeele\\InertiaSymfony\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
